# ===== 数据库 =====
# PostgreSQL 连接（snake_case 表由 Prisma schema 定义）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aa_split?schema=public"

# ===== Redis / BullMQ =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
# access token 有效期 30 天，refresh 7 天（refresh 通过返回体下发）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# ===== 对象存储 =====
# local | minio（默认 local：文件存到本地磁盘 UPLOAD_DIR）
OBJECT_STORAGE=local
# MinIO（S3 兼容）配置
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aa-split
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# 本地存储目录（OBJECT_STORAGE=local 时使用）
UPLOAD_DIR=./uploads

# ===== 服务 =====
PORT=3000
# 允许跨域来源，逗号分隔，* 表示全部
CORS_ORIGINS=*
# 是否开启 Swagger 文档（/api/docs）
SWAGGER_ENABLED=true

# ===== 服务器时区（定期账单计算统一 Asia/Shanghai）=====
TZ=Asia/Shanghai
