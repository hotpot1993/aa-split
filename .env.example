# ============ 复制为 .env 并修改 ============

# --- PostgreSQL ---
POSTGRES_USER=aa
POSTGRES_PASSWORD=aa_dev_password
POSTGRES_DB=aa_split
DATABASE_URL=postgresql://aa:aa_dev_password@localhost:5432/aa_split?schema=public

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=aa-minio
MINIO_SECRET_KEY=aa_minio_dev_password
MINIO_BUCKET=aa-receipts
MINIO_USE_SSL=false
# 对外访问 base（预签名 URL 的 host）
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Server ---
PORT=3000
CORS_ORIGINS=http://localhost:5173

# --- Swagger ---
SWAGGER_ENABLED=true
